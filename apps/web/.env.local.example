# Copy to apps/web/.env.local and replace every TODO_FILL_MANUALLY value locally.
# Never commit real credentials, database contents, or production paths.

# Application/runtime
DATABASE_URL="file:/absolute/path/to/xistance-panel/packages/db/prisma/dev.db"
XT_DATA_DIR="/absolute/path/to/xistance-panel/tunnels"
XT_KEY_DIR="/absolute/path/to/xistance-panel/tunnels/keys"
XT_ENV_FILE="/absolute/path/to/xistance-panel/apps/web/.env.local"
XT_FORWARDER_SCRIPT="/absolute/path/to/xistance-panel/packages/tunnel-core/src/forwarder-runner.ts"
XT_FORCE_NODE="true"
XT_PANEL_HOST="127.0.0.1"
XT_TRUST_PROXY="false"
XT_ALLOWED_ORIGINS="http://localhost:3000"
XT_DEMO="false"
NEXT_RUNTIME="nodejs"
NODE_ENV="development"

# Secrets: fill these manually on the target host; do not paste them into docs or evidence.
XTENC_KEY="TODO_FILL_MANUALLY_32_BYTE_HEX"
JWT_SECRET="TODO_FILL_MANUALLY_RANDOM_HEX"
XT_ADMIN_EMAIL="admin@example.invalid"
XT_ADMIN_PASSWORD="TODO_FILL_MANUALLY"

# Local-only convenience; production service configuration is managed by the installer.
PORT="3000"
HOSTNAME="127.0.0.1"

