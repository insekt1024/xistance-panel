# Copy to apps/web/.env.local and adjust paths for your machine.
DATABASE_URL="file:/absolute/path/to/xistance-panel/packages/db/prisma/dev.db"
XT_DATA_DIR="/absolute/path/to/xistance-panel/tunnels"
XT_FORCE_NODE="true"
XTENC_KEY="dev-32-byte-hex-secret-0000000000000000"
JWT_SECRET="dev-only-jwt-secret"
# Set true ONLY behind a sanitizing reverse proxy (trusts X-Forwarded-For for IP rate limits).
# XT_TRUST_PROXY="false"
